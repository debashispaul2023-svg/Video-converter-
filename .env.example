# FFmpeg / ffprobe binaries. Use absolute paths if they are not on PATH.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
CAPABILITY_PROBE_TIMEOUT_SECONDS=10
UPLOAD_TIMEOUT_SECONDS=21600
FFPROBE_TIMEOUT_SECONDS=30
CONVERSION_TIMEOUT_SECONDS=43200
DEFAULT_AAC_BITRATE=128k
DEFAULT_H264_CRF=23
DEFAULT_X264_PRESET=medium
DEFAULT_H265_CRF=28
DEFAULT_H265_PRESET=medium
LOG_LEVEL=INFO

# Canonical size limits are bytes. 21474836480 = 20 GiB. 5368709120 = 5 GiB reserve.
# Do not set MAX_UPLOAD_SIZE_MB. GB in API errors means this binary size.
MAX_UPLOAD_SIZE_BYTES=21474836480
MIN_FREE_DISK_SPACE_BYTES=5368709120
UPLOAD_CHUNK_BYTES=1048576
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=3600
JOB_RETENTION_MINUTES=60
JOB_RETENTION_SECONDS=86400
WORKER_CONCURRENCY=1
TEMP_DIRECTORY=/tmp/video-converter
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=
RATE_LIMIT_UPLOADS=30
RATE_LIMIT_CONVERSIONS=60
MAX_TARGET_SIZE_BYTES=21474836480
MAX_BATCH_FILES=10
